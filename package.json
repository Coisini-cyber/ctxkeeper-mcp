{
  "name": "ctxkeeper-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first MCP server that gives AI coding agents durable project memory and token-budgeted context packs. No API keys, no vector DB.",
  "mcpName": "io.github.coisini-cyber/ctxkeeper",
  "license": "MIT",
  "author": "Sixian Deng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coisini-cyber/ctxkeeper-mcp.git"
  },
  "homepage": "https://github.com/Coisini-cyber/ctxkeeper-mcp#readme",
  "bugs": {
    "url": "https://github.com/Coisini-cyber/ctxkeeper-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "coding-agents",
    "context-engineering",
    "memory",
    "developer-tools",
    "typescript",
    "claude-code",
    "cursor",
    "opencode"
  ],
  "type": "module",
  "bin": {
    "ctxkeeper": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
